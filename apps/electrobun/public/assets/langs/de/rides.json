            },
            "3": {
                "n": "Gebärsam",
                "d": "Ein gebärsames Reittier bringt mehr Nachkommen zur Welt als ein normales Reittier.",
                "e": "null"
            },
            "4": {
                "n": "Wahrhaft weise",
                "d": "Ein wahrhaft weises Reittier entwickelt sich doppelt so schnell wie ein normales Reittier.",
                "e": "null"
            },
            "5": {
                "n": "Ausdauernd",
                "d": "Ein ausdauerndes Reittier steigert seine Ausdauer viel schneller als ein normales Reittier.",
                "e": "null"
            },
            "6": {
                "n": "Verliebt",
                "d": "Ein verliebtes Reittier steigert die Liebe viel schneller als ein normales Reittier.",
