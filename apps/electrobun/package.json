{
	"name": "dofus-electrobun-app",
	"version": "1.0.0",
	"description": "Dofus Web Client - Electrobun App",
	"type": "module",
	"scripts": {
		"dev": "bun run build && electrobun dev",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run dev\"",
		"hmr": "vite --port 5173",
		"build": "vite build && electrobun build",
		"build:prod": "vite build && electrobun build --channel prod",
		"start": "electrobun run",
		"extract": "lingui extract",
		"compile": "lingui compile",
		"test": "bun test",
		"check-types": "electrobun prepare && tsc --noEmit && tsc --noEmit -p tsconfig.electrobun.json",
		"lint": "biome check src"
	},
	"dependencies": {
		"@base-ui/react": "^1.3.0",
		"@bufbuild/protobuf": "^2.2.3",
		"@dofus/dofasset-format": "workspace:*",
		"@dofus/grid": "workspace:*",
		"@dofus/proto": "workspace:*",
		"@dofus/protocol": "workspace:*",
		"@dofus/spell-runtime": "workspace:*",
		"@fontsource-variable/geist": "^5.2.8",
		"@lingui/babel-plugin-lingui-macro": "^5.9.3",
		"@lingui/cli": "^5.9.3",
		"@lingui/core": "^5.9.3",
		"@lingui/macro": "^5.9.3",
		"@lingui/vite-plugin": "^5.9.3",
		"@pixi/compressed-textures": "^7.4.3",
		"@pixi/layout": "latest",
		"@pixi/ui": "latest",
		"@radix-ui/react-slot": "^1.2.4",
		"@xstate/react": "^5.0.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"electrobun": "2.0.1",
		"fflate": "^0.8.2",
		"fzstd": "^0.1.1",
		"lucide-react": "^1.8.0",
		"pixi-filters": "^6.1.5",
		"pixi.js": "latest",
		"react": "19.2.5",
		"react-dom": "19.2.5",
		"shadcn": "^4.2.0",
		"tailwind-merge": "^3.5.0",
		"ts-pattern": "catalog:",
		"tw-animate-css": "^1.4.0",
		"ws": "^8.19.0",
		"xstate": "^5.19.2"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.2.2",
		"@types/bun": "latest",
		"@types/compression": "^1.8.1",
		"@types/node": "^24.10.9",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@types/three": "^0.183.1",
		"@vitejs/plugin-react": "^4.3.0",
		"compression": "^1.8.1",
		"concurrently": "^9.1.0",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.7.2",
		"vite": "^6.0.3"
	}
}
