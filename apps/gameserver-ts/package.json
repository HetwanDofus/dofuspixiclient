{
  "name": "@dofus/gameserver-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:gateway": "bun run src/gateway/main.ts",
    "dev:gamed": "MODE=game bun --watch run src/core/main.ts",
    "dev:authd": "MODE=auth bun --watch run src/core/main.ts",
    "start:gateway": "bun run src/gateway/main.ts",
    "start:core": "bun run src/core/main.ts",
    "build": "bun build src/gateway/main.ts --target=bun --outfile=dist/gateway.js && bun build src/core/main.ts --target=bun --outfile=dist/core.js",
    "db:make": "bunx kysely migrate:make",
    "db:migrate": "bunx kysely migrate:latest",
    "db:rollback": "bunx kysely migrate:down",
    "db:status": "bunx kysely migrate:list",
    "test:e2e": "bun test test/",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "TESTCONTAINERS_RYUK_DISABLED=true bun test",
    "test:unit": "bun test src/",
    "test:integration": "TESTCONTAINERS_RYUK_DISABLED=true bun test test/integration",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.3",
    "@dofus/dofus-lang": "workspace:*",
    "@dofus/grid": "workspace:*",
    "@dofus/proto": "workspace:*",
    "@dofus/uds-transport": "workspace:*",
    "@inquirer/prompts": "^8.4.1",
    "@nestjs-cls/transactional": "^3.2.0",
    "@nestjs-cls/transactional-adapter-kysely": "^1.4.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/event-emitter": "^2.1.1",
    "hono": "^4.12.12",
    "ink": "^7.0.0",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "ioredis": "^5.4.1",
    "kysely": "^0.28.2",
    "nestjs-cls": "^6.2.0",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-pattern": "^5.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@testcontainers/postgresql": "10.24.2",
    "testcontainers": "11.8.0",
    "@types/bun": "^1.1.14",
    "@types/node": "catalog:",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.14",
    "bun-types": "^1.3.12",
    "kysely-ctl": "^0.13.0",
    "typescript": "catalog:"
  }
}
