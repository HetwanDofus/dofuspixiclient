# Local dev environment for gameserver-ts (loaded automatically by Bun).
DATABASE_URL=postgres://dofus:dofus@localhost:5432/dofus
LOG_LEVEL=debug
GATEWAY_PORT=8080
CORE_SOCK=/tmp/dofus-gamed.sock
AUTH_SOCK=/tmp/dofus-authd.sock

# Arms the admin API on the gateway: `POST /admin/accounts` (QA-126) and
# `POST /admin/handoff`. Left unset, neither route is registered at all.
# Setting it makes DATABASE_URL above mandatory for the gateway too — it
# provisions straight into the database and refuses to boot without one.
# GATEWAY_ADMIN_TOKEN=change-me

# Where a brand new character wakes up — the seed script and the gateway's
# provisioning API both read it. Defaults to 7411, the Astrub zaap, where the
# dev Féca stands.
# SPAWN_MAP_ID=7411
