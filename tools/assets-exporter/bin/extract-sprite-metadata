#!/usr/bin/env php
<?php

require_once __DIR__ . '/../vendor/autoload.php';

use App\Command\ExtractSpriteMetadataCommand;
use Symfony\Component\Console\Application;

$application = new Application('Sprite Metadata Extractor', '1.0.0');
$application->addCommand(new ExtractSpriteMetadataCommand());
$application->setDefaultCommand('sprites:metadata', true);
$application->run();
