#!/usr/bin/env php
<?php

require_once __DIR__ . '/../vendor/autoload.php';

use App\Command\ExtractStaticMetadataCommand;
use Symfony\Component\Console\Application;

$application = new Application('Static Metadata Extractor', '1.0.0');
$application->addCommand(new ExtractStaticMetadataCommand());
$application->setDefaultCommand('static:metadata', true);
$application->run();
