#!/usr/bin/env php
<?php

require_once __DIR__ . '/../vendor/autoload.php';

use App\Command\ExtractLangsCommand;
use Symfony\Component\Console\Application;

$application = new Application('Lang Extractor', '1.0.0');
$application->addCommand(new ExtractLangsCommand());
$application->setDefaultCommand('langs:extract', true);
$application->run();
